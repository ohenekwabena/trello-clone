# Email Service Configuration
# Choose one of the following email service providers and add the corresponding API key

# Option 1: Resend (Recommended for Next.js) - https://resend.com
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# EMAIL_FROM=noreply@yourdomain.com

# Option 2: SendGrid - https://sendgrid.com
# SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# EMAIL_FROM=noreply@yourdomain.com

# Option 3: SMTP (Generic email service)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-specific-password
# EMAIL_FROM=noreply@yourdomain.com

# Application URL (required for generating invite links)
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
